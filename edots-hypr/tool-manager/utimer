#!/usr/bin/env bash

# Terminal Colors for readability
BLUE='\033[1;34m'
GREEN='\033[1;32m'
RED='\033[1;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

COMMAND=$1
DURATION=$2
shift 2
MESSAGE="${*:-Your timer has finished!}"

AUDIO_FILE="$HOME/edots-hypr/tool-manager/timer-end.mp3"

show_help() {
  echo -e "${BLUE}Background Timer Utility (utimer)${NC}"
  echo "Usage: utimer [command] [duration] [message]"
  echo ""
  echo "Commands:"
  echo "  start <time> [msg]    Start a background timer (e.g., 30s, 10m, 2h)"
  echo "  help                  Show this help message"
}

if [ -z "$COMMAND" ]; then
  show_help
  exit 1
fi

case "$COMMAND" in
start)
  if [ -z "$DURATION" ]; then
    echo -e "${RED}Error: Specify a duration (e.g., 30s, 10m, 2h).${NC}"
    exit 1
  fi

  echo -e "${GREEN}==> Setting background timer for $DURATION...${NC}"

  nohup bash -c '
            sleep "$1"
            AUDIO_FILE="$2"
            MESSAGE="$3"
            
            LOOP_PID=""
            if [ -f "$AUDIO_FILE" ]; then
                # Run infinite loop in subshell
                ( while true; do 
                    mpv --no-video --no-terminal "$AUDIO_FILE" 2>/dev/null || \
                    pw-play "$AUDIO_FILE" 2>/dev/null || \
                    paplay "$AUDIO_FILE" 2>/dev/null || break
                done ) &
                LOOP_PID=$!
            fi

            # Wait until user closes the notification in SwayNC
            notify-send -u critical -i clock "Timer Complete" "$MESSAGE" --wait

            # Stop both the audio player process and the loop subshell
            if [ -n "$LOOP_PID" ]; then
                pkill -P "$LOOP_PID" 2>/dev/null
                kill "$LOOP_PID" 2>/dev/null
            fi
        ' _ "$DURATION" "$AUDIO_FILE" "$MESSAGE" >/dev/null 2>&1 &

  echo -e "${BLUE}Timer running in background. SwayNC will notify you when it's up!${NC}"
  ;;

help | --help | -h)
  show_help
  ;;

*)
  echo -e "${RED}Error: Unknown command '$COMMAND'.${NC}"
  show_help
  exit 1
  ;;
esac
