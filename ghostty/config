# Ghostty — під той самий стиль, що Kitty/Alacritty в цьому рису.
# Кольори — окремий файл, перегенеровується wallcolors.py при зміні шпалери.
config-file = ghostty-colors.conf

font-family = "JetBrainsMono Nerd Font"
font-size = 11

window-padding-x = 12
window-padding-y = 12
window-padding-balance = true

# Прозорість — 0.65. На деяких Wayland-сесіях GTK-збірка Ghostty може не
# завжди застосовувати альфа-канал ідеально, тож це лишається best-effort.
# Лишаю тут про всяк випадок (на майбутнє, якщо поведінку покращать).
background-opacity = 0.65
background-blur = false

# Рамка/заокруглення/тінь керуються композитором, не дублюємо їх тут через CSD.
window-decoration = false

cursor-style = block
cursor-style-blink = true

mouse-hide-while-typing = true

# Live-reload конфігу вбудований у Ghostty (файли підхоплюються на льоту),
# додатково: ctrl+shift+, для форс-релоаду.
