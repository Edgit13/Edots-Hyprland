#!/usr/bin/env bash

# Terminal Colors for readability
BLUE='\033[1;34m'
GREEN='\033[1;32m'
RED='\033[1;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

COMMAND=$1
PACKAGE=$2

show_help() {
    echo -e "${BLUE}Universal Package Manager Wrapper (upkg)${NC}"
    echo "Usage: upkg [command] [package]"
    echo ""
    echo "Commands:"
    echo "  update            Update all packages (pacman, AUR, flatpak)"
    echo "  install <pkg>     Install a package (prompts for source)"
    echo "  remove  <pkg>     Remove a package (prompts for source)"
    echo "  search  <pkg>     Search for a package across all managers"
    echo "  clean             Clean package caches and unused runtimes"
    echo "  help              Show this help message"
}

if [ -z "$COMMAND" ]; then
    show_help
    exit 1
fi

case "$COMMAND" in
    update)
        echo -e "${GREEN}==> Updating Arch Repos & AUR (yay)...${NC}"
        yay -Syu
        echo -e "${GREEN}==> Updating Flatpaks...${NC}"
        flatpak update
        echo -e "${BLUE}System is fully up to date!${NC}"
        ;;
        
    install)
        if [ -z "$PACKAGE" ]; then echo -e "${RED}Error: Specify a package to install.${NC}"; exit 1; fi
        echo -e "${YELLOW}Where do you want to install '$PACKAGE' from?${NC}"
        echo "1) Arch Repos / AUR (yay)"
        echo "2) Flathub (flatpak)"
        echo "3) Cancel"
        read -p "Select an option (1-3): " choice
        
        case $choice in
            1) yay -S "$PACKAGE" ;;
            2) flatpak install "$PACKAGE" ;;
            3) echo "Installation cancelled." ;;
            *) echo -e "${RED}Invalid option.${NC}" ;;
        esac
        ;;
        
    remove)
        if [ -z "$PACKAGE" ]; then echo -e "${RED}Error: Specify a package to remove.${NC}"; exit 1; fi
        echo -e "${YELLOW}Where is '$PACKAGE' installed?${NC}"
        echo "1) Arch Repos / AUR (yay)"
        echo "2) Flathub (flatpak)"
        read -p "Select an option (1-2): " choice
        
        case $choice in
            1) yay -Rns "$PACKAGE" ;;
            2) flatpak uninstall "$PACKAGE" ;;
            *) echo -e "${RED}Invalid option.${NC}" ;;
        esac
        ;;
        
    search)
        if [ -z "$PACKAGE" ]; then echo -e "${RED}Error: Specify a package to search.${NC}"; exit 1; fi
        echo -e "${GREEN}==> Searching Arch Repos & AUR...${NC}"
        yay -Ss "$PACKAGE"
        echo ""
        echo -e "${GREEN}==> Searching Flathub...${NC}"
        flatpak search "$PACKAGE"
        ;;
        
    clean)
        echo -e "${GREEN}==> Cleaning yay/pacman cache...${NC}"
        yay -Scc
        echo -e "${GREEN}==> Removing unused Flatpak runtimes...${NC}"
        flatpak uninstall --unused
        ;;
        
    help|*)
        show_help
        ;;
esac
